<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{dd/MM/yyyy HH:mm:ss.SSS} %-5level %c{1} - %msg%n"/>
        </Console>
        <RollingFile name="RuntimeFile"
                     fileName="logs/runtime/aplicacion.log"
                     filePattern="logs/runtime/aplicacion-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{dd/MM/yyyy HH:mm:ss.SSS} %-5level %c{1} - %msg%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="1 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RuntimeFile"/>
        </Root>
    </Loggers>
</Configuration>
